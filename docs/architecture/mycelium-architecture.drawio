ique source kind + external source ID; record key: source + external record ID. Deleted note keeps provenance." style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="35" y="47" width="990.5999999999999" height="32" as="geometry"/></mxCell><mxCell id="14-import-provenance-edge-0" value="note_id: SET NULL" edge="1" source="14-import-provenance-import_records" target="14-import-provenance-notes" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;strokeColor=#65778a;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="510" y="220"/></Array></mxGeometry></mxCell><mxCell id="14-import-provenance-edge-1" value="source_id: RESTRICT" edge="1" source="14-import-provenance-import_records" target="14-import-provenance-import_sources" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;strokeColor=#65778a;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="510" y="349"/></Array></mxGeometry></mxCell><mxCell id="14-import-provenance-edge-2" value="source_id: RESTRICT" edge="1" source="14-import-provenance-import_runs" target="14-import-provenance-import_sources" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;strokeColor=#65778a;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="510" y="483"/></Array></mxGeometry></mxCell><mxCell id="14-import-provenance-import_sources" value="&lt;b&gt;import_sources&lt;/b&gt;&lt;br&gt;&lt;br&gt;PK id&lt;br&gt;kind, source_id&lt;br&gt;5 columns · full detail in inventory" link="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src-tauri/src/database/schema/data.sql" tooltip="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src-tauri/src/database/schema/data.sql" vertex="1" parent="1" style="rounded=1;