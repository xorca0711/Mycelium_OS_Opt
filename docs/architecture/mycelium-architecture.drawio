mula. No causal claim is implied." style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="35" y="47" width="2147.4" height="32" as="geometry"/></mxCell><mxCell id="12-analytics-edge-0" value="timestamps" edge="1" source="12-analytics-sleep" target="12-analytics-window" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;dashed=1;strokeColor=#9673a6;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="477" y="540"/></Array></mxGeometry></mxCell><mxCell id="12-analytics-edge-1" value="completion within interval" edge="1" source="12-analytics-tasks" target="12-analytics-output" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;dashed=1;strokeColor=#9673a6;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1070" y="185"/></Array></mxGeometry></mxCell><mxCell id="12-analytics-edge-2" value="node_id match" edge="1" source="12-analytics-effort" target="12-analytics-output" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;dashed=1;strokeColor=#9673a6;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1070" y="357"/></Array></mxGeometry></mxCell><mxCell id="12-analytics-edge-3" value="bounded interval" edge="1" source="12-analytics-window" target="12-analytics-output" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;dashed=1;strokeColor=#9673a6;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1070" y="540"/></Array></mxGeometry></mxCell><mxCell id="12-analytics-edge-4" value="derived results" edge="1" source="12-analytics-output" target="12-analytics-views" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;dashed=1;strokeColor=#9673a6;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1682" y="357"/></Array></mxGeometry></mxCell><mxCell id="12-analytics-sleep" value="&lt;b&gt;Sleep history&lt;/b&gt;&lt;br&gt;&lt;br&gt;sleep_entries: wake_time, sleep_start&lt;br&gt;Non-nap records in calendar window" link="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src/plugins/AnalyticsPlugin/panels/planner-sleep/sleepWindowData.ts" tooltip="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src/plugins/AnalyticsPlugin/panels/planner-sleep/sleepWindowData.ts" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="35" y="485" width="350" height="110" as="geometry"/></mxCell><mxCell id="12-analytics-tasks" value="&lt;b&gt;Completed planner tasks&lt;/b&gt;&lt;br&gt;&lt;br&gt;nodes: actual_completed_at, arc_id&lt;br&gt;Events excluded; future tasks excluded" link="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src/plugins/PlannerPlugin/lib/plannerDb.ts" tooltip="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src/plugins/PlannerPlugin/lib/plannerDb.ts" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="569" y="130" width="350" height="110" as="geometry"/></mxCell><mxCell id="12-analytics-effort" value="&lt;b&gt;Tracked effort&lt;/b&gt;&lt;br&gt;&lt;br&gt;session_nodes: node_id, total_minutes&lt;br&gt;SUM across task sessions, including&lt;br&gt;effort from incomplete attempts" link="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src/plugins/PlannerPlugin/lib/onTheClockDb.ts" tooltip="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src/plugins/PlannerPlugin/lib/onTheClockDb.ts"