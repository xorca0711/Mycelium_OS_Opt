tps://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src/plugins/AnalyticsPlugin/panels/planner-sleep/PlannerSleepPanel.tsx" tooltip="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src/plugins/AnalyticsPlugin/panels/planner-sleep/PlannerSleepPanel.tsx" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="1792" y="290" width="350" height="133" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="13-preferences" name="Personal profile / preference history"><mxGraphModel page="1" pageWidth="1050" pageHeight="351" grid="1" gridSize="10"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="13-preferences-title" value="Personal profile / preference history" style="text;html=1;whiteSpace=wrap;fontSize=24;align=left;" vertex="1" parent="1"><mxGeometry x="35" y="10" width="980" height="32" as="geometry"/></mxCell><mxCell id="13-preferences-legend" value="One SQLite file | arrows: child -&gt; parent | solid: declared FK + ON DELETE | dashed: application/JSON join. Typed JSON v1; migration v5. Current revision and immutable history are saved in one transaction." style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="35" y="47" width="980" height="32" as="geometry"/></mxCell><mxCell id="13-preferences-edge-0" value="revision: logical" edge="1" source="13-preferences-personal_settings" target="13-preferences-personal_settings_history" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;dashed=1;strokeColor=#9673a6;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="503" y="208"/></Array></mxGeometry></mxCell><mxCell id="13-preferences-personal_settings" value="&lt;b&gt;personal_settings&lt;/b&gt;&lt;br&gt;&lt;br&gt;PK id&lt;br&gt;~ revision -&amp;gt; personal_