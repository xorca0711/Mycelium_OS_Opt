329"/></Array></mxGeometry></mxCell><mxCell id="15-import-flow-edge-2" value="snapshot" edge="1" source="15-import-flow-preview" target="15-import-flow-review" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;strokeColor=#65778a;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="410" y="594"/></Array></mxGeometry></mxCell><mxCell id="15-import-flow-edge-3" value="Import reviewed notes" edge="1" source="15-import-flow-review" target="15-import-flow-gate" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;strokeColor=#65778a;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="410" y="859"/></Array></mxGeometry></mxCell><mxCell id="15-import-flow-edge-4" value="fresh local check" edge="1" source="15-import-flow-gate" target="15-import-flow-commit" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;strokeColor=#65778a;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="410" y="1101"/></Array></mxGeometry></mxCell><mxCell id="15-import-flow-edge-5" value="atomic writes" edge="1" source="15-import-flow-commit" target="15-import-flow-db" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;strokeColor=#65778a;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="410" y="1366"/></Array></mxGeometry></mxCell><mxCell id="15-import-flow-notion" value="&lt;b&gt;Selected Notion source&lt;/b&gt;&lt;br&gt;&lt;br&gt;Page / database / data source&lt;br&gt;Token in memory; no startup fetch&lt;br&gt;Read-only remote API; bounded preview" link="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src/lib/imports/notionClient.ts" tooltip="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src/lib/imports/notionClient.ts" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=14;fillColor=#f5f5f5;strokeColor=#8b949e;"><mxGeometry x="35" y="130" width="350" height="133" as="geometry"/></mxCell><mxCell id="15-import-flow-file" value="&lt;b&gt;Selected CSV / JSON&lt;/b&gt;&lt;br&gt;&lt;br&gt;Local file up to 10 MiB&lt;br&gt;Stable source label + ID/title/text fields&lt;br&gt;At most 500 records per batch" link="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src/lib/imports/files.ts" tooltip="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src/lib/imports/files.ts" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=14;fillColor=#f5f5f5;strokeColor=#8b949e;"><mxGeometry x="435" y="130" width="350" height="133" as="geometry"/></mxCell><mxCell id="15-import-flow-preview" value="&lt;b&gt;Build preview&lt;/b&gt;&lt;br&gt;&lt;br&gt;Text + properties into note text&lt;br&gt;Relations remain IDs, not joined tables&lt;br&gt;Hash / external-ID classification" link="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src/lib/imports/model.ts" tooltip="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src/lib/imports/model.ts" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="235" y="395" width="350" height="133" as="geometry"/></mxCell><mxCell id="15-import-flow-review" value="&lt;b&gt;User reviews actions&lt;/b&gt;&lt;br&gt;&lt;br&gt;Create / update / unchanged / conflict&lt;br&gt;Cancel or explicitly import&lt;br&gt;No task mapping or media downloads" link="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src/plugins/SettingsPlugin/sections/DataImportSection.tsx" tooltip="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src/plugins/SettingsPlugin/sections/DataImportSection.tsx" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="235" y="660" width="350" height="133" as="geometry"/></mxCell><mxCell id="15-import-flow-gate" value="&lt;b&gt;Maintenance gate&lt;/b&gt;&lt;br&gt;&lt;br&gt;Flush shared note drafts&lt;br&gt;Block overlapping workspace operations" link="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src/store/useDataMaintenanceStore.ts" tooltip="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src/store/useDataMaintenanceStore.ts" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="235" y="925" width="350" height="110" as="geometry"/></mxCell><mxCell id="15-import-flow-commit" value="&lt;b&gt;Recheck and commit&lt;/b&gt;&lt;br&gt;&lt;br&gt;Re-read current notes and hashes&lt;br&gt;Skip local edits / archived / deleted&lt;br&gt;executeBatch: one transaction" link="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src/lib/imports/repository.ts" tooltip="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src/lib/imports/repository.ts" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;"><mxGeometry x="235" y="1167" width="350" height="133" as="geometry"/></mxCell><mxCell id="15-import-flow-db" value="&lt;b&gt;Same SQLite database&lt;/b&gt;&lt;br&gt;&lt;br&gt;notes + title aliases&lt;br&gt;import_sources / import_records&lt;br&gt;import_runs: successful batch counts" link="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src-tauri/src/database/schema/data.sql" tooltip="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src-tauri/src/database/schema/data.sql" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;"><mxGeometry x="235" y="1432" width="350" height="133" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="16-backup-restore" name="Backup / staged restore / restart"><mxGraphModel page="1" pageWidth="1050" pageHeight="1895" grid="1" gridSize="10"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="16-backup-restore-title" value="Backup / staged restore / restart" style="text;html=1;whiteSpace=wrap;fontSize=24;align=left;" vertex="1" parent="1"><mxGeometry x="35" y="10" width="980" height="32" as="geometry"/></mxCell><mxCell id="16-backup-restore-legend" value="Restore operates on a staged copy; original data is retained. External SQLite tools are outside the app maintenance gate." style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;" vertex="1" parent="1"><mxGeometry x="35" y="47" width="980" height="32" as="geometry"/></mxCell><mxCell id="16-backup-restore-edge-0" value="Create backup" edge="1" source="16-backup-restore-ui" target="16-backup-restore-snapshot" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;strokeColor=#65778a;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="210" y="306"/></Array></mxGeometry></mxCell><mxCell id="16-backup-restore-edge-1" value="snapshot bundle" edge="1" source="16-backup-restore-snapshot" target="16-backup-restore-folder" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;strokeColor=#65778a;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="210" y="571"/></Array></mxGeometry></mxCell><mxCell id="16-backup-restore-edge-2" value="select + validate" edge="1" source="16-backup-restore-folder" target="16-backup-restore-validate" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;strokeColor=#65778a;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="210" y="836"/></Array></mxGeometry></mxCell><mxCell id="16-backup-restore-edge-3" value="explicit stage" edge="1" source="16-backup-restore-validate" target="16-backup-restore-stage" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;strokeColor=#65778a;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="210" y="1101"/></Array></mxGeometry></mxCell><mxCell id="16-backup-restore-edge-4" value="restart required" edge="1" source="16-backup-restore-stage" target="16-backup-restore-restart" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;strokeColor=#65778a;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="210" y="1366"/></Array></mxGeometry></mxCell><mxCell id="16-backup-restore-edge-5" value="recoverable folder swap" edge="1" source="16-backup-restore-restart" target="16-backup-restore-active" parent="1" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;strokeColor=#65778a;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="210" y="1631"/></Array></mxGeometry></mxCell><mxCell id="16-backup-restore-ui" value="&lt;b&gt;Settings Data controls&lt;/b&gt;&lt;br&gt;&lt;br&gt;Explicit backup / validate / stage&lt;br&gt;Flush notes; maintenance blocks edits" link="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src/plugins/SettingsPlugin/sections/DataBackupRestore.tsx" tooltip="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src/plugins/SettingsPlugin/sections/DataBackupRestore.tsx" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="35" y="130" width="350" height="110" as="geometry"/></mxCell><mxCell id="16-backup-restore-snapshot" value="&lt;b&gt;Create backup&lt;/b&gt;&lt;br&gt;&lt;br&gt;Drain shared pool; VACUUM INTO&lt;br&gt;Copy four media folders; reopen pool&lt;br&gt;Capture allowlisted WebView preferences" link="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src-tauri/src/data_management/mod.rs" tooltip="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src-tauri/src/data_management/mod.rs" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;"><mxGeometry x="35" y="372" width="350" height="133" as="geometry"/></mxCell><mxCell id="16-backup-restore-folder" value="&lt;b&gt;New backup folder&lt;/b&gt;&lt;br&gt;&lt;br&gt;SQLite + media + manifest&lt;br&gt;Schema version, checksums, preferences&lt;br&gt;Separate from active environment" link="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src-tauri/src/data_management/backup.rs" tooltip="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src-tauri/src/data_management/backup.rs" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;"><mxGeometry x="35" y="637" width="350" height="133" as="geometry"/></mxCell><mxCell id="16-backup-restore-validate" value="&lt;b&gt;Validate chosen backup&lt;/b&gt;&lt;br&gt;&lt;br&gt;Manifest / paths / checksums&lt;br&gt;SQLite integrity + FK checks&lt;br&gt;Schema compatibility + media refs" link="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src-tauri/src/data_management/backup.rs" tooltip="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src-tauri/src/data_management/backup.rs" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;"><mxGeometry x="35" y="902" width="350" height="133" as="geometry"/></mxCell><mxCell id="16-backup-restore-stage" value="&lt;b&gt;Prepare staged copy&lt;/b&gt;&lt;br&gt;&lt;br&gt;Copy + validate again; migrate copy&lt;br&gt;Relink managed media paths&lt;br&gt;Write restore-pending control file" link="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src-tauri/src/data_management/restore.rs" tooltip="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src-tauri/src/data_management/restore.rs" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;"><mxGeometry x="35" y="1167" width="350" height="133" as="geometry"/></mxCell><mxCell id="16-backup-restore-restart" value="&lt;b&gt;Next native startup&lt;/b&gt;&lt;br&gt;&lt;br&gt;Lock the data environment&lt;br&gt;Apply pending before opening SQL pool&lt;br&gt;Retain original folder as rollback" link="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src-tauri/src/data_management/restore.rs" tooltip="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src-tauri/src/data_management/restore.rs" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;"><mxGeometry x="35" y="1432" width="350" height="133" as="geometry"/></mxCell><mxCell id="16-backup-restore-active" value="&lt;b&gt;Restored workspace&lt;/b&gt;&lt;br&gt;&lt;br&gt;Database + media become active&lt;br&gt;Apply allowlisted localStorage keys&lt;br&gt;Acknowledge preference handoff" link="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src/App.tsx" tooltip="https://github.com/xorca0711/Mycelium_OS_Opt/blob/codex/local-setup/O_neash%20Dash/src/App.tsx" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;"><mxGeometry x="35" y="1697" width="350" height="133" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>